{
  "name": "backend",
  "version": "1.0.0",
  "description": "Koa starter with sensible defaults and best-practice configuration for production-ready applications",
  "license": "ISC",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --p tsconfig.prod.json && npm run copy-files",
    "copy-files": "cp ./src/openapi.json ./dist/",
    "db:clean": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:migrate:development": "dotenv -e .env.development -- npx prisma migrate dev",
    "db:migrate:production": "dotenv -e .env -- npx prisma migrate dev",
    "db:migrate:test": "dotenv -e .env.test -- npx prisma migrate dev",
    "db:seed:development": "cross-env NODE_ENV=development node --loader ts-node/esm --enable-source-maps --experimental-specifier-resolution=node prisma/seed.ts",
    "db:seed:production": "cross-env NODE_ENV=production node --loader ts-node/esm --enable-source-maps --experimental-specifier-resolution=node prisma/seed.ts",
    "db:seed:test": "cross-env NODE_ENV=test node --loader ts-node/esm --enable-source-maps --experimental-specifier-resolution=node prisma/seed.ts",
    "db:studio": "prisma studio",
    "format": "npm run format:prettier && npm run format:code",
    "format:code": "eslint . --fix",
    "format:prettier": "prettier --write \"src/**/*.{ts,tsx,json}\" \"types/**/*.{ts,tsx,json}\" \"prisma/**/*.{ts,tsx,json}\" \"test/**/*.{ts,tsx,json}\"",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:commit": "commitlint -e",
    "lint:ts": "tsc --noEmit",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "start": "npm run start:dev",
    "start:debug": "cross-env NODE_ENV=development nodemon --inspect ./src/index.ts",
    "start:dev": "cross-env NODE_ENV=development nodemon ./src/index.ts",
    "start:prod": "cross-env NODE_ENV=production node --experimental-specifier-resolution=node dist/index.js",
    "swagger:generate": "node --loader ts-node/esm --enable-source-maps --experimental-specifier-resolution=node swagger.generate.ts",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js",
    "test:coverage": "cross-env NODE_ENV=test node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "npm run db:clean && cross-env NODE_ENV=test node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js --config jest.e2e.config.ts",
    "test:e2e:coverage": "npm run db:clean && cross-env NODE_ENV=test node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js --config jest.e2e.config.ts --coverage"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^15.2.0",
    "@prisma/adapter-better-sqlite3": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "friendly-di": "^1.0.1",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^9.0.0",
    "koa-logger": "^4.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "multer": "^2.0.2",
    "proper-url-join": "^2.1.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "server-destroy": "^1.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@jest/globals": "^30.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/debug": "^4.1.12",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/koa": "^3.0.1",
    "@types/koa-bodyparser": "^5.0.2",
    "@types/koa-logger": "^3.1.5",
    "@types/koa__cors": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.9",
    "@types/proper-url-join": "^2.1.5",
    "@types/server-destroy": "^1.0.4",
    "@types/source-map-support": "^0.5.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-package-json": "^0.88.1",
    "eslint-plugin-perfectionist": "^5.4.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-regexp": "^3.0.0",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "swagger-jsdoc": "^6.2.8",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
